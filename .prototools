node = "24.20.0"
pnpm = "11.15.0"
moon = "2.5.3"

# Matches the deno bundled inside supabase/edge-runtime (see
# services/functions/deno/Dockerfile). The edge worker executes on the
# runtime's own deno, so checking the tree against a newer one lets syntax
# and APIs the runtime rejects pass `edge:check`. Bump this only alongside
# the edge-runtime tag, after confirming the new image's `deno --version`.
deno = "2.1.4"
# Matches rust-toolchain.toml; the crates from KBVE/workspace are edition 2024.
rust = "1.98.0"

# Pinned to match uv.toml at the repo root, which uv itself enforces. The
# interpreter is deliberately not pinned here: uv resolves it from each
# project's .python-version and downloads its own build, so a pin here would be
# a second claim that loses silently. proto pins uv; uv pins python.
uv = "0.11.29"
