---
/**
 * AstroGithubReadme - Build-time fetch of a raw GitHub markdown file
 * (e.g. a repo README), rendered to HTML. Strips YAML frontmatter.
 *
 * Mermaid fences stay as code blocks. The site bakes its own diagrams to SVG
 * ahead of time and ships no mermaid runtime, and the markdown here comes from
 * a remote URL that can change after the bake — so there is nothing to look up.
 */
import { Marked } from 'marked';

interface Props {
	url: string;
}

const { url } = Astro.props;

const stripFrontmatter = (md: string) =>
	md.replace(/^---\r?\n[\s\S]*?\r?\n---\r?\n?/, '');

const marked = new Marked({ gfm: true, breaks: false });

let html = '';
let failed = false;

try {
	const res = await fetch(url);
	if (!res.ok) throw new Error(`${res.status} ${res.statusText}`);
	const raw = await res.text();
	html = await marked.parse(stripFrontmatter(raw));
} catch {
	failed = true;
}
---

{
	failed ? (
		<p>
			Could not load the README at build time.{' '}
			<a href={url} target="_blank" rel="noopener noreferrer">
				View it on GitHub
			</a>
			.
		</p>
	) : (
		<div class="github-readme" set:html={html} />
	)
}
