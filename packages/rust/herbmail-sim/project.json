{
	"name": "herbmail-sim",
	"$schema": "../../../node_modules/nx/schemas/project-schema.json",
	"projectType": "library",
	"sourceRoot": "packages/rust/herbmail-sim/src",
	"tags": ["rust", "physics", "herbmail"],
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"options": {
				"command": "cargo build -p herbmail-sim"
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"options": {
				"command": "cargo test -p herbmail-sim"
			}
		},
		"lint": {
			"executor": "nx:run-commands",
			"options": {
				"command": "cargo clippy -p herbmail-sim --all-targets -- -D warnings"
			}
		}
	}
}
