{
	"name": "q",
	"$schema": "../../../node_modules/nx/schemas/project-schema.json",
	"projectType": "library",
	"sourceRoot": "packages/rust/q/src",
	"targets": {
		"build": {
			"executor": "@monodon/rust:build",
			"outputs": ["{options.target-dir}"],
			"options": {
				"target-dir": "dist/target/q"
			},
			"configurations": {
				"production": {
					"release": true
				}
			}
		},
		"test": {
			"executor": "@monodon/rust:test",
			"outputs": ["{options.target-dir}"],
			"options": {
				"target-dir": "dist/target/q"
			},
			"configurations": {
				"production": {
					"release": true
				}
			}
		},
		"lint": {
			"executor": "@monodon/rust:lint",
			"outputs": ["{options.target-dir}"],
			"options": {
				"target-dir": "dist/target/q"
			}
		},

		"test-all": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "packages/rust/q",
				"commands": [
					"cargo test --lib --features net-godot",
					"cargo test --lib --no-default-features --features net-server,net-session"
				],
				"parallel": false
			}
		},

		"e2e": {
			"executor": "nx:run-commands",
			"options": {
				"commands": ["nx run q:test-all"],
				"parallel": false
			}
		},
		"build-mac": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "packages/rust/q",
				"commands": [
					"cargo +nightly build -Z build-std=std,panic_abort  -Z unstable-options --features net-godot --target aarch64-apple-darwin --artifact-dir dist/macos --release",
					"mkdir -p release/addons/q/macos",
					"cp dist/macos/*.dylib release/addons/q/macos/",
					"bash scripts/sign-dylib.sh release/addons/q/macos/libq.dylib"
				],
				"parallel": false
			}
		},

		"build-linux": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "packages/rust/q",
				"commands": [
					"cargo build --release -p q --features net-godot --target-dir ../../../dist/target/q"
				],
				"parallel": false
			},
			"outputs": ["{workspaceRoot}/dist/target/q/release/libq.so"]
		},

		"deploy-linux": {
			"executor": "nx:run-commands",
			"dependsOn": ["build-linux"],
			"options": {
				"cwd": "packages/rust/q",
				"commands": [
					"mkdir -p ../../../apps/friendslop/godot-friendslop/addons/q/linux",
					"cp ../../../dist/target/q/release/libq.so ../../../apps/friendslop/godot-friendslop/addons/q/linux/libq.so"
				],
				"parallel": false
			}
		},

		"build-ios": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "packages/rust/q",
				"commands": [
					"cargo build --features net-godot --target aarch64-apple-ios --release"
				],
				"parallel": false
			}
		},

		"deploy-ios": {
			"executor": "nx:run-commands",
			"dependsOn": ["build-ios"],
			"options": {
				"cwd": "packages/rust/q",
				"commands": [
					"mkdir -p ../../../apps/friendslop/godot-friendslop/addons/q/ios/libq.framework",
					"cp ../../../dist/target/aarch64-apple-ios/release/libq.dylib ../../../apps/friendslop/godot-friendslop/addons/q/ios/libq.framework/libq",
					"install_name_tool -id @rpath/libq.framework/libq ../../../apps/friendslop/godot-friendslop/addons/q/ios/libq.framework/libq",
					"codesign --force --sign - --timestamp=none ../../../apps/friendslop/godot-friendslop/addons/q/ios/libq.framework"
				],
				"parallel": false
			}
		},

		"deploy-mac": {
			"executor": "nx:run-commands",
			"dependsOn": ["build-mac"],
			"options": {
				"cwd": "packages/rust/q",
				"commands": [
					"mkdir -p ../../../apps/friendslop/godot-friendslop/addons/q/macos",
					"cp dist/macos/libq.dylib ../../../apps/friendslop/godot-friendslop/addons/q/macos/libq.dylib",
					"bash scripts/sign-dylib.sh ../../../apps/friendslop/godot-friendslop/addons/q/macos/libq.dylib"
				],
				"parallel": false
			}
		},

		"debug-mac": {
			"executor": "nx:run-commands",
			"options": {
				"commands": ["pnpm nx run q:build-mac"],
				"parallel": false
			}
		}
	},
	"tags": []
}
