{
	"start": "greet",
	"speaker": "npc.marlow.name",
	"nodes": {
		"greet": {
			"line": "npc.marlow.greet",
			"if": { "not": { "seen": "greet" } },
			"else": "greet_again",
			"to": "menu"
		},
		"greet_again": {
			"line": "npc.marlow.greet_again",
			"to": "menu"
		},
		"menu": {
			"line": "npc.marlow.menu",
			"choices": [
				{ "text": "dlg.marlow.ask_bridge", "to": "bridge" },
				{ "text": "dlg.marlow.ask_river", "to": "river" },
				{
					"text": "dlg.marlow.ask_toll",
					"to": "toll",
					"if": { "not": "marlow_toll_paid" }
				},
				{
					"text": "dlg.marlow.ask_mechs",
					"to": "mechs",
					"if": "marlow_toll_paid"
				},
				{ "text": "dlg.leave", "to": "farewell" }
			]
		},
		"bridge": {
			"line": "npc.marlow.bridge",
			"to": "menu"
		},
		"river": {
			"line": "npc.marlow.river",
			"do": { "set": "marlow_knows_river" },
			"to": "menu"
		},
		"toll": {
			"line": "npc.marlow.toll",
			"choices": [
				{
					"text": "dlg.marlow.pay",
					"to": "toll_paid",
					"do": { "set": "marlow_toll_paid" }
				},
				{ "text": "dlg.marlow.refuse", "to": "toll_refused" }
			]
		},
		"toll_paid": {
			"line": "npc.marlow.toll_paid",
			"to": "menu"
		},
		"toll_refused": {
			"line": "npc.marlow.toll_refused",
			"to": "menu"
		},
		"mechs": {
			"line": "npc.marlow.mechs",
			"to": "menu"
		},
		"farewell": {
			"line": "npc.marlow.farewell",
			"if": { "not": "marlow_toll_paid" },
			"else": "farewell_paid"
		},
		"farewell_paid": {
			"line": "npc.marlow.farewell_paid"
		}
	}
}
