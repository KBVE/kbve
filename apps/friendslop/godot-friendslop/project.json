{
	"name": "godot-friendslop",
	"$schema": "../../../node_modules/nx/schemas/project-schema.json",
	"projectType": "application",
	"sourceRoot": "apps/friendslop/godot-friendslop",
	"tags": ["scope:friendslop", "type:godot-app"],
	"targets": {
		"editor": {
			"executor": "nx:run-commands",
			"options": {
				"command": "bash scripts/godot.sh --editor .",
				"cwd": "apps/friendslop/godot-friendslop"
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"options": {
				"command": "bash scripts/test.sh",
				"cwd": "apps/friendslop/godot-friendslop"
			}
		},
		"test:smoke": {
			"executor": "nx:run-commands",
			"options": {
				"command": "bash scripts/godot.sh --headless -s tests/smoke_ecs.gd",
				"cwd": "apps/friendslop/godot-friendslop"
			}
		},
		"run": {
			"executor": "nx:run-commands",
			"options": {
				"command": "bash scripts/godot.sh .",
				"cwd": "apps/friendslop/godot-friendslop"
			}
		},
		"dev": {
			"executor": "nx:run-commands",
			"dependsOn": [
				{
					"projects": ["q"],
					"target": "deploy-mac"
				}
			],
			"options": {
				"command": "bash scripts/godot.sh .",
				"cwd": "apps/friendslop/godot-friendslop"
			}
		},
		"dev:editor": {
			"executor": "nx:run-commands",
			"dependsOn": [
				{
					"projects": ["q"],
					"target": "deploy-mac"
				}
			],
			"options": {
				"command": "bash scripts/godot.sh --editor .",
				"cwd": "apps/friendslop/godot-friendslop"
			}
		},
		"export:windows": {
			"executor": "nx:run-commands",
			"options": {
				"command": "mkdir -p ../../../dist/apps/friendslop/windows && bash scripts/godot.sh --headless --export-release \"Windows Desktop\"",
				"cwd": "apps/friendslop/godot-friendslop"
			},
			"outputs": ["{workspaceRoot}/dist/apps/friendslop/windows"]
		},
		"export:macos": {
			"executor": "nx:run-commands",
			"options": {
				"command": "mkdir -p ../../../dist/apps/friendslop/macos && bash scripts/godot.sh --headless --export-release \"macOS\"",
				"cwd": "apps/friendslop/godot-friendslop"
			},
			"outputs": ["{workspaceRoot}/dist/apps/friendslop/macos"]
		},
		"export:linux": {
			"executor": "nx:run-commands",
			"options": {
				"command": "mkdir -p ../../../dist/apps/friendslop/linux && bash scripts/godot.sh --headless --export-release \"Linux\"",
				"cwd": "apps/friendslop/godot-friendslop"
			},
			"outputs": ["{workspaceRoot}/dist/apps/friendslop/linux"]
		},
		"export:ios": {
			"executor": "nx:run-commands",
			"dependsOn": ["q:deploy-ios"],
			"options": {
				"command": "bash scripts/ios.sh export",
				"cwd": "apps/friendslop/godot-friendslop"
			},
			"outputs": ["{workspaceRoot}/dist/apps/friendslop/ios"]
		},
		"install:ios": {
			"executor": "nx:run-commands",
			"dependsOn": ["export:ios"],
			"options": {
				"command": "bash scripts/ios.sh install",
				"cwd": "apps/friendslop/godot-friendslop"
			}
		},
		"run:ios": {
			"executor": "nx:run-commands",
			"dependsOn": ["install:ios"],
			"options": {
				"command": "bash scripts/ios.sh run",
				"cwd": "apps/friendslop/godot-friendslop"
			}
		},
		"export": {
			"executor": "nx:run-commands",
			"options": {
				"commands": [
					"nx run godot-friendslop:export:windows",
					"nx run godot-friendslop:export:macos",
					"nx run godot-friendslop:export:linux"
				],
				"parallel": false
			}
		},
		"i18n:sync": {
			"executor": "nx:run-commands",
			"inputs": ["{workspaceRoot}/packages/data/i18n/locales/**/*.json"],
			"outputs": ["{projectRoot}/assets/i18n"],
			"options": {
				"cwd": "{workspaceRoot}",
				"commands": [
					"rm -rf apps/friendslop/godot-friendslop/assets/i18n",
					"mkdir -p apps/friendslop/godot-friendslop/assets/i18n",
					"cp -R packages/data/i18n/locales/. apps/friendslop/godot-friendslop/assets/i18n/"
				],
				"parallel": false
			},
			"cache": true
		},
		"bake:turf": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "{workspaceRoot}",
				"commands": [
					"blender -b -P packages/python/kbve/kbve/blender/turf_bake.py -- --out apps/friendslop/godot-friendslop/assets/biomes/grassland/textures --res 2048 --ao-samples 40",
					"python3 packages/python/kbve/kbve/blender/pack_orm.py apps/friendslop/godot-friendslop/assets/biomes/grassland/textures"
				],
				"parallel": false
			}
		}
	}
}
