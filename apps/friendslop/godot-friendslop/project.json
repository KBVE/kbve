{
	"name": "godot-friendslop",
	"$schema": "../../../node_modules/nx/schemas/project-schema.json",
	"projectType": "application",
	"sourceRoot": "apps/friendslop/godot-friendslop",
	"tags": ["scope:friendslop", "type:godot-app"],
	"targets": {
		"editor": {
			"executor": "nx:run-commands",
			"options": {
				"command": "godot --editor .",
				"cwd": "apps/friendslop/godot-friendslop"
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"options": {
				"commands": [
					"godot --headless --import",
					"godot --headless -d -s res://addons/gdUnit4/bin/GdUnitCmdTool.gd --ignoreHeadlessMode -a res://tests -c"
				],
				"parallel": false,
				"cwd": "apps/friendslop/godot-friendslop"
			}
		},
		"test:smoke": {
			"executor": "nx:run-commands",
			"options": {
				"command": "godot --headless -s tests/smoke_ecs.gd",
				"cwd": "apps/friendslop/godot-friendslop"
			}
		},
		"run": {
			"executor": "nx:run-commands",
			"options": {
				"command": "godot .",
				"cwd": "apps/friendslop/godot-friendslop"
			}
		},
		"dev": {
			"executor": "nx:run-commands",
			"dependsOn": [{ "projects": ["q"], "target": "deploy-mac" }],
			"options": {
				"command": "godot .",
				"cwd": "apps/friendslop/godot-friendslop"
			}
		},
		"dev:editor": {
			"executor": "nx:run-commands",
			"dependsOn": [{ "projects": ["q"], "target": "deploy-mac" }],
			"options": {
				"command": "godot --editor .",
				"cwd": "apps/friendslop/godot-friendslop"
			}
		},
		"export:windows": {
			"executor": "nx:run-commands",
			"options": {
				"command": "mkdir -p ../../../dist/apps/friendslop/windows && godot --headless --export-release \"Windows Desktop\"",
				"cwd": "apps/friendslop/godot-friendslop"
			},
			"outputs": ["{workspaceRoot}/dist/apps/friendslop/windows"]
		},
		"export:macos": {
			"executor": "nx:run-commands",
			"options": {
				"command": "mkdir -p ../../../dist/apps/friendslop/macos && godot --headless --export-release \"macOS\"",
				"cwd": "apps/friendslop/godot-friendslop"
			},
			"outputs": ["{workspaceRoot}/dist/apps/friendslop/macos"]
		},
		"export:linux": {
			"executor": "nx:run-commands",
			"options": {
				"command": "mkdir -p ../../../dist/apps/friendslop/linux && godot --headless --export-release \"Linux\"",
				"cwd": "apps/friendslop/godot-friendslop"
			},
			"outputs": ["{workspaceRoot}/dist/apps/friendslop/linux"]
		},
		"export:ios": {
			"executor": "nx:run-commands",
			"dependsOn": ["q:deploy-ios"],
			"options": {
				"command": "bash scripts/ios.sh export",
				"cwd": "apps/friendslop/godot-friendslop"
			},
			"outputs": ["{workspaceRoot}/dist/apps/friendslop/ios"]
		},
		"install:ios": {
			"executor": "nx:run-commands",
			"dependsOn": ["export:ios"],
			"options": {
				"command": "bash scripts/ios.sh install",
				"cwd": "apps/friendslop/godot-friendslop"
			}
		},
		"run:ios": {
			"executor": "nx:run-commands",
			"dependsOn": ["install:ios"],
			"options": {
				"command": "bash scripts/ios.sh run",
				"cwd": "apps/friendslop/godot-friendslop"
			}
		},
		"export": {
			"executor": "nx:run-commands",
			"options": {
				"commands": [
					"nx run godot-friendslop:export:windows",
					"nx run godot-friendslop:export:macos",
					"nx run godot-friendslop:export:linux"
				],
				"parallel": false
			}
		}
	}
}
