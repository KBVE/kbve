####################
# Kilobase Test Runner
# Builds the extension, installs into PostgreSQL 17, and runs SQL-based e2e tests
#
# Usage (via Nx):
#   nx run kilobase:container-test   # build
#   nx run kilobase:e2e              # build + test
####################

####################
# Stage 0: Build kilobase extension (mirrors production Stage 0)
####################
FROM rust:bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl gnupg2 lsb-release ca-certificates \
    libclang-dev pkg-config libssl-dev && \
    echo "deb http://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" > /etc/apt/sources.list.d/pgdg.list && \
    curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc | gpg --dearmor -o /etc/apt/trusted.gpg.d/pgdg.gpg && \
    apt-get update && apt-get install -y --no-install-recommends postgresql-server-dev-17 && \
    rm -rf /var/lib/apt/lists/*

RUN cargo install cargo-pgrx --version "=0.19.2" --locked
RUN cargo pgrx init --pg17=/usr/bin/pg_config

WORKDIR /build
COPY . .

# Build the extension package
RUN cargo pgrx package --pg-config /usr/bin/pg_config --features pg17

# Also run unit tests during build
RUN cargo test --lib --features pg17

####################
# Stage 0b: pg_durable (mirrors production Stage 0b)
####################
FROM rust:bookworm AS pgdurable

ARG PG_DURABLE_VERSION=v0.2.5

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl gnupg2 lsb-release ca-certificates git \
    libclang-dev clang pkg-config libssl-dev && \
    echo "deb http://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" > /etc/apt/sources.list.d/pgdg.list && \
    curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc | gpg --dearmor -o /etc/apt/trusted.gpg.d/pgdg.gpg && \
    apt-get update && apt-get install -y --no-install-recommends postgresql-server-dev-17 && \
    rm -rf /var/lib/apt/lists/*

RUN cargo install cargo-pgrx --version "=0.16.1" --locked
RUN cargo pgrx init --pg17=/usr/bin/pg_config

RUN git clone --depth 1 --branch "${PG_DURABLE_VERSION}" \
        https://github.com/microsoft/pg_durable.git /pgdurable

WORKDIR /pgdurable

RUN cargo pgrx package --pg-config /usr/bin/pg_config

####################
# Stage 1: Test image — PostgreSQL 17 + kilobase .so + test runner
####################
FROM postgres:17-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3 ca-certificates && rm -rf /var/lib/apt/lists/*

# Copy built extension artifacts from builder
COPY --from=builder /build/target/release/kilobase-pg17/usr/share/postgresql/17/extension/kilobase* /usr/share/postgresql/17/extension/
COPY --from=builder /build/target/release/kilobase-pg17/usr/lib/postgresql/17/lib/kilobase.so /usr/lib/postgresql/17/lib/kilobase.so

COPY --from=pgdurable /pgdurable/target/release/pg_durable-pg17/usr/share/postgresql/17/extension/ /usr/share/postgresql/17/extension/
COPY --from=pgdurable /pgdurable/target/release/pg_durable-pg17/usr/lib/postgresql/17/lib/ /usr/lib/postgresql/17/lib/

# Copy the SQL test script to /tests/ (NOT initdb.d — avoid double execution)
COPY sql/test_kilobase.sql /tests/test_kilobase.sql

# The cluster is initialised at build time and the official entrypoint is not
# used at all.
#
# That entrypoint boots a temporary server and shuts it down before starting the
# real one. The temporary server listens on the unix socket only, so pg_durable's
# worker cannot reach it over TCP and spends ~10s in a connection-pool timeout
# before it notices the shutdown request. Added to initdb, that pushed startup
# past the readiness window. The worker does shut down cleanly — measured at 16s
# in the worst case — it is simply slower than the bootstrap cycle allows for.
#
# Initialising here removes the cycle entirely: at runtime the server starts once
# and stays up. That also removes the bootstrap race readiness detection was
# working around. PGDATA is deliberately not /var/lib/postgresql/data — that path
# is a VOLUME in the base image, so build-time writes there are discarded.
#
# Both workers target `postgres`, which is also the database the extension runs in
# under Supabase. max_sleep_seconds is dropped to 1 so a refresh is observable
# within a test.
ENV PGDATA=/pgdata

RUN mkdir -p /pgdata && chown postgres:postgres /pgdata

USER postgres

RUN initdb -D /pgdata --auth-local=trust --auth-host=trust && \
    printf "listen_addresses = '127.0.0.1'\nshared_preload_libraries = 'kilobase,pg_durable'\nkilobase.database = 'postgres'\nkilobase.max_sleep_seconds = 1\npg_durable.database = 'postgres'\npg_durable.worker_role = 'postgres'\npg_durable.enable_superuser_instances = on\n" \
        >> /pgdata/postgresql.conf

USER root

# The test entrypoint script
COPY sql/run_tests.sh /run_tests.sh
RUN chmod +x /run_tests.sh

USER postgres

CMD ["/run_tests.sh"]
