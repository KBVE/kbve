---
export interface Props {
	/** TradingView symbol, e.g. `amex:spy`. */
	data?: string;
	/** Chart interval passed to the widget. */
	interval?: string;
	/** Chart height; any CSS length. */
	height?: string;
	class?: string;
}

const {
	data = 'BITSTAMP:BTCUSD',
	interval = 'D',
	height = 'clamp(20rem, 55vh, 34rem)',
	class: className,
} = Astro.props;

const containerId = `tv-${data.replace(/[^a-z0-9]+/gi, '-').toLowerCase()}`;
---

<tv-widget
	class:list={['tv-widget', className]}
	data-symbol={data}
	data-interval={interval}
	data-container-id={containerId}
	style={`--tv-height:${height}`}>
	<div class="tv-frame">
		<div class="tv-surface" id={containerId}>
			<div class="tv-placeholder" data-tv-placeholder>
				<span class="tv-placeholder__symbol">{data.toUpperCase()}</span>
				<span class="tv-placeholder__hint">Chart loads on scroll</span>
			</div>
		</div>
		<a
			class="tv-credit"
			href={`https://www.tradingview.com/symbols/${data.replace(':', '-')}/`}
			target="_blank"
			rel="noopener">
			{data.toUpperCase()} chart by TradingView
		</a>
	</div>
</tv-widget>

<style>
	.tv-widget {
		display: block;
		width: 100%;
	}

	.tv-frame {
		display: flex;
		flex-direction: column;
		width: 100%;
		background-color: var(--bento-cell-bg, rgba(255, 255, 255, 0.02));
		border: 1px solid
			var(--bento-hairline-strong, rgba(255, 255, 255, 0.12));
		border-radius: var(--bento-radius, 12px);
		overflow: hidden;
	}

	.tv-surface {
		position: relative;
		width: 100%;
		height: var(--tv-height);
		min-height: 0;
	}

	.tv-surface :global(iframe) {
		display: block;
		width: 100% !important;
		height: 100% !important;
		border: 0;
	}

	.tv-placeholder {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
	}

	.tv-placeholder__symbol {
		font-size: 1.125rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		color: var(--sl-color-white);
	}

	.tv-placeholder__hint {
		font-size: 0.75rem;
		color: var(--sl-color-gray-3);
	}

	.tv-credit {
		flex: none;
		padding: 0.5rem 0.75rem;
		border-top: 1px solid var(--bento-hairline, rgba(255, 255, 255, 0.08));
		font-size: 0.75rem;
		color: var(--sl-color-gray-3);
		text-decoration: none;
	}

	.tv-credit:hover {
		color: var(--sl-color-white);
	}
</style>

<script is:inline data-astro-rerun>
	(function () {
		if (customElements.get('tv-widget')) return;

		const SRC = 'https://s3.tradingview.com/tv.js';
		let loader = null;

		function loadLibrary() {
			if (window.TradingView) return Promise.resolve();
			if (loader) return loader;
			loader = new Promise(function (resolve, reject) {
				let script = document.querySelector('script[data-tv-loader]');
				if (!script) {
					script = document.createElement('script');
					script.src = SRC;
					script.async = true;
					script.setAttribute('data-tv-loader', '');
					document.head.appendChild(script);
				}
				script.addEventListener('load', function () {
					resolve();
				});
				script.addEventListener('error', function () {
					loader = null;
					reject(new Error('tradingview script failed'));
				});
			});
			return loader;
		}

		function currentTheme() {
			return document.documentElement.getAttribute('data-theme') ===
				'light'
				? 'light'
				: 'dark';
		}

		class TradingViewChart extends HTMLElement {
			constructor() {
				super();
				this.widget = null;
				this.observer = null;
				this.themeObserver = null;
				this.pending = false;
			}

			connectedCallback() {
				if (this.observer || this.widget) return;
				this.observer = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (!entry.isIntersecting) continue;
							this.observer.disconnect();
							this.observer = null;
							this.render();
							return;
						}
					},
					{ rootMargin: '200px' },
				);
				this.observer.observe(this);
			}

			disconnectedCallback() {
				this.observer?.disconnect();
				this.observer = null;
				this.themeObserver?.disconnect();
				this.themeObserver = null;
				this.destroyWidget();
			}

			destroyWidget() {
				if (this.widget) {
					try {
						this.widget.remove();
					} catch {}
					this.widget = null;
				}
				this.querySelector('.tv-surface')
					?.querySelectorAll('iframe')
					.forEach((frame) => frame.remove());
			}

			watchTheme() {
				if (this.themeObserver) return;
				this.themeObserver = new MutationObserver(() => {
					if (this.widget) this.render();
				});
				this.themeObserver.observe(document.documentElement, {
					attributes: true,
					attributeFilter: ['data-theme'],
				});
			}

			render() {
				if (this.pending) return;
				this.pending = true;
				loadLibrary()
					.then(() => {
						this.pending = false;
						if (!this.isConnected || !window.TradingView) return;
						this.destroyWidget();
						this.querySelector('[data-tv-placeholder]')?.remove();
						this.widget = new window.TradingView.widget({
							autosize: true,
							symbol: this.dataset.symbol,
							interval: this.dataset.interval || 'D',
							timezone: 'Etc/UTC',
							theme: currentTheme(),
							style: '1',
							locale: 'en',
							enable_publishing: false,
							allow_symbol_change: true,
							container_id: this.dataset.containerId,
						});
						this.watchTheme();
					})
					.catch(() => {
						this.pending = false;
						const hint = this.querySelector(
							'.tv-placeholder__hint',
						);
						if (hint) hint.textContent = 'Chart unavailable';
					});
			}
		}

		customElements.define('tv-widget', TradingViewChart);
	})();
</script>
