---
import BentoShell from '@/components/hero/BentoShell.astro';
import ReactWorkflowsDashRN from './ReactWorkflowsDashRN';
import ReactWindmillJobs from '@/components/dashboard/ReactWindmillJobs';
import RnDashSkeleton from '@/components/dashboard/RnDashSkeleton.astro';
---

<BentoShell
	id="workflows-canvas"
	eyebrow="Automation"
	heading="Workflows — invoke across edge, firecracker, and Windmill.">
	<div class="wf-dash not-content">
		<div class="wf-canvas not-content">
			<ReactWorkflowsDashRN client:only="react">
				<RnDashSkeleton slot="fallback" tiles={3} rows={5} />
			</ReactWorkflowsDashRN>
		</div>
	</div>
</BentoShell>

<BentoShell
	id="workflows-jobs"
	eyebrow="Windmill"
	heading="Job history — workspace kbve.">
	<div class="wf-dash not-content">
		<ReactWindmillJobs client:only="react" />
	</div>
</BentoShell>

<style>
	.wf-dash {
		padding: 1.5rem 1rem 3rem;
	}

	@media (min-width: 640px) {
		.wf-dash {
			padding-inline: 1.5rem;
		}
	}

	.wf-canvas {
		height: 60vh;
		min-height: 440px;
		display: flex;
		flex-direction: column;
		border: 1px solid var(--bento-hairline-strong, rgba(255, 255, 255, 0.1));
		border-radius: var(--bento-radius, 0.625rem);
		overflow: hidden;
	}

	.wf-canvas :global(astro-island) {
		display: flex;
		flex: 1 1 auto;
		min-height: 0;
	}
</style>
