---
import BentoShell from '@/components/hero/BentoShell.astro';
import ReactHomeAuth from './ReactHomeAuth';
import ReactAlerts from './ReactAlerts';
---

<BentoShell
	id="alerts-wrapper"
	eyebrow="Monitoring"
	heading="Alerts — Alertmanager history.">
	<div class="alerts-dash not-content">
		<ReactHomeAuth client:only="react">
			<div class="alerts-panel not-content">
				<ReactAlerts client:only="react" />
			</div>
		</ReactHomeAuth>
	</div>
</BentoShell>

<style>
	.alerts-dash {
		padding: 1.5rem 1rem 3rem;
	}

	@media (min-width: 640px) {
		.alerts-dash {
			padding-inline: 1.5rem;
		}
	}

	.alerts-panel {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.alerts-panel :global(.recharts-cartesian-grid line) {
		stroke: var(--sl-color-gray-5);
	}

	.alerts-panel :global(.recharts-cartesian-axis-tick-value) {
		fill: var(--sl-color-gray-2);
	}

	.alerts-panel :global(.recharts-label-list text) {
		fill: var(--sl-color-text);
		paint-order: stroke;
		stroke: var(--sl-color-bg-nav);
		stroke-width: 3px;
	}

	.alerts-panel :global(.kbve-sev-critical) {
		fill: var(--kbve-status-critical);
	}
	.alerts-panel :global(.kbve-sev-warning) {
		fill: var(--kbve-status-warning);
	}
	.alerts-panel :global(.kbve-sev-info) {
		fill: var(--kbve-status-info);
	}
	.alerts-panel :global(.kbve-sev-neutral) {
		fill: var(--kbve-status-neutral);
	}
</style>
