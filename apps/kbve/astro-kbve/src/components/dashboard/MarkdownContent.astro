---
import Default from '@astrojs/starlight/components/MarkdownContent.astro';

const section = Astro.locals.kbveSection;
const crumbs = section?.crumbs ?? [];
---

{
	crumbs.length > 0 && (
		<nav
			class="dash-breadcrumb bento-section not-content"
			aria-label="Breadcrumb">
			<div class="dash-breadcrumb__frame bento-frame bento-frame--fluid">
				<ol>
					{crumbs.map((crumb, i) => (
						<li>
							{i < crumbs.length - 1 ? (
								<a href={crumb.href}>{crumb.label}</a>
							) : (
								<span aria-current="page">{crumb.label}</span>
							)}
						</li>
					))}
				</ol>
			</div>
		</nav>
	)
}

<Default>
	<slot />
</Default>

<style>
	.dash-breadcrumb {
		--bento-frame-base: 95rem;
		display: block;
	}

	.dash-breadcrumb__frame {
		display: flex;
		width: 100%;
	}

	.dash-breadcrumb ol {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.375rem;
		width: 100%;
		margin: 0;
		padding: 0.625rem 1.25rem;
		list-style: none;
		font-size: 0.8125rem;
		line-height: 1.4;
	}

	@media (min-width: 1024px) {
		.dash-breadcrumb ol {
			padding-inline: 1.5rem;
		}
	}

	.dash-breadcrumb li {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		min-width: 0;
	}

	.dash-breadcrumb li:not(:first-child)::before {
		content: '';
		flex: none;
		width: 0.375rem;
		height: 0.375rem;
		border-top: 1.5px solid var(--sl-color-gray-4);
		border-right: 1.5px solid var(--sl-color-gray-4);
		transform: rotate(45deg);
		opacity: 0.55;
	}

	.dash-breadcrumb a,
	.dash-breadcrumb span[aria-current='page'] {
		display: inline-flex;
		align-items: center;
		max-width: 14rem;
		padding: 0.3rem 0.6rem;
		border-radius: 6px;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.dash-breadcrumb a {
		color: var(--sl-color-gray-2);
		text-decoration: none;
		transition:
			color 160ms ease,
			background-color 160ms ease;
	}

	.dash-breadcrumb a:hover {
		color: var(--sl-color-white);
		background-color: color-mix(
			in srgb,
			var(--sl-color-white) 4%,
			transparent
		);
	}

	.dash-breadcrumb span[aria-current='page'] {
		color: var(--sl-color-white);
		font-weight: 600;
		background-color: color-mix(
			in srgb,
			var(--sl-color-accent-high) 18%,
			transparent
		);
	}
</style>
