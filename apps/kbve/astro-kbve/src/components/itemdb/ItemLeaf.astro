---
import BentoDoc from '@/components/hero/BentoDoc.astro';
import BentoProse from '@/components/hero/BentoProse.astro';
import BentoShell from '@/components/hero/BentoShell.astro';
import ItemDBPanel from './ItemDBPanel.astro';
import ItemDetails from './ItemDetails.astro';
import { findRelated } from './itemRelated';
import { IObjectSchema } from '@/data/schema';
import { getCategoryNames } from '@/data/types/ItemCategoryTypes';
import { RARITY_META } from './itemNav';

const { data } = Astro.props;
const item = IObjectSchema.parse(data);

const titleCase = (v: string): string =>
	String(v ?? '')
		.replace(/[-_]/g, ' ')
		.replace(/\b\w/g, (c) => c.toUpperCase());

const RARITY_THEME: Record<string, { accent: string; accent2: string }> = {
	common: { accent: '#94a3b8', accent2: '#cbd5e1' },
	uncommon: { accent: '#22c55e', accent2: '#4ade80' },
	rare: { accent: '#3b82f6', accent2: '#60a5fa' },
	epic: { accent: '#a855f7', accent2: '#c084fc' },
	legendary: { accent: '#f59e0b', accent2: '#fbbf24' },
	mythic: { accent: '#f43f5e', accent2: '#fb7185' },
};

const rarityKey = item.rarity ?? 'common';
const rarity = titleCase(rarityKey);
const rarityMeta = RARITY_META.find((m) => m.key === rarityKey);
const categoryNames = item.type_flags ? getCategoryNames(item.type_flags) : [];
const primaryType = categoryNames[0] ?? 'Item';

const lede =
	typeof item.description === 'string'
		? item.description.trim().split('\n\n')[0].replace(/\n/g, ' ')
		: undefined;

const grid = item.grid as { width?: number; height?: number } | undefined;
const gridW = grid?.width ?? 1;
const gridH = grid?.height ?? 1;
const cells = gridW * gridH;

const stats: {
	label: string;
	value: string;
	icon: string;
	detail?: string;
}[] = [];

stats.push({
	label: 'Type',
	value: primaryType,
	icon: 'database',
	detail: [
		categoryNames.length > 1
			? `Also ${categoryNames.slice(1).join(', ').toLowerCase()}`
			: null,
		item.equipment?.slot
			? `${titleCase(item.equipment.slot)} slot`
			: item.action
				? `${titleCase(item.action)} action`
				: null,
	]
		.filter(Boolean)
		.join(' · '),
});

stats.push({
	label: 'Rarity',
	value: rarity,
	icon: 'crown',
	detail: `${rarityMeta?.eyebrow ?? 'Tier'}${
		item.set_ref ? ` · ${titleCase(item.set_ref)} set` : ''
	}`,
});

if (item.buy_price !== undefined)
	stats.push({
		label: 'Value',
		value: `${item.buy_price.toLocaleString()} $KHash`,
		icon: 'chart',
		detail:
			item.sell_price !== undefined
				? `Sells back for ${item.sell_price.toLocaleString()} (${Math.round(
						(item.sell_price / (item.buy_price || 1)) * 100,
					)}%)`
				: item.tradeable === false
					? 'Not tradeable'
					: undefined,
	});

if (item.weight !== undefined)
	stats.push({
		label: 'Carry',
		value: `${item.weight} kg`,
		icon: 'activity',
		detail: [
			`${gridW}×${gridH} — ${cells} cell${cells === 1 ? '' : 's'}`,
			item.stackable
				? `stacks to ${item.max_stack ?? '∞'}`
				: 'does not stack',
		].join(' · '),
	});

if (item.level_requirement || item.equipment?.max_durability || item.cooldown)
	stats.push({
		label: item.level_requirement ? 'Level req.' : 'Wear',
		value: item.level_requirement
			? String(item.level_requirement)
			: item.equipment?.max_durability
				? String(item.equipment.max_durability)
				: `${item.cooldown}s`,
		icon: 'shield',
		detail: [
			item.equipment?.max_durability
				? `${item.equipment.max_durability} durability`
				: null,
			item.cooldown ? `${item.cooldown}s cooldown` : null,
			item.quest_requirement
				? `Requires ${titleCase(item.quest_requirement)}`
				: null,
		]
			.filter(Boolean)
			.join(' · '),
	});

const hero = {
	badge: `${rarityMeta?.eyebrow ?? 'Item'} · ${rarity}`,
	title: item.emoji ? `${item.emoji} ${item.name}` : item.name,
	accent: primaryType,
	lede,
	stats,
	ctas: [
		{ label: '← All items', href: '/itemdb/' },
		{ label: `${rarity} tier`, href: `/itemdb/#${rarityKey}` },
	],
	related: [
		{
			href: `/itemdb/#${rarityKey}`,
			title: `More ${rarity}`,
			copy: `Browse the rest of the ${rarity.toLowerCase()} tier in the catalog.`,
			icon: 'network',
		},
		{
			href: '/itemdb/',
			title: 'Item Database',
			copy: 'Back to the full catalog, grouped by rarity tier.',
			icon: 'database',
		},
		{
			href: '/api/itemdb.json',
			title: 'JSON API',
			copy: 'This catalog as machine-readable JSON, keyed by id, ref, and name.',
			icon: 'code',
		},
	],
	theme: RARITY_THEME[rarityKey] ?? RARITY_THEME.common,
};

const related = await findRelated(data as Record<string, unknown>);

const hasDetails = Boolean(
	item.recipes?.length ||
	item.equipment ||
	item.food ||
	item.use_effects?.length ||
	(item.sources as unknown[] | undefined)?.length,
);

const lore = typeof item.lore === 'string' ? item.lore.trim() : '';
const credits = typeof item.credits === 'string' ? item.credits.trim() : '';
---

<BentoDoc data={hero} class="item-leaf">
	<BentoProse eyebrow="Entry" heading="Item">
		<ItemDBPanel data={data} />
		<slot />
	</BentoProse>

	{
		hasDetails && (
			<BentoShell
				id="details"
				eyebrow="Mechanics"
				heading="How it works"
				sub="Crafting, equipment, and effects declared on this entry.">
				<ItemDetails data={data} />
			</BentoShell>
		)
	}

	{
		lore && (
			<BentoShell id="lore" eyebrow="Chronicle" heading="Lore">
				<div class="item-lore not-content">
					<blockquote class="item-lore__body">{lore}</blockquote>
					{credits && <p class="item-lore__credits">{credits}</p>}
				</div>
			</BentoShell>
		)
	}

	{
		related.length > 0 && (
			<BentoShell
				id="related-items"
				eyebrow="Catalog"
				heading="Related items"
				sub="Other entries that share a set, tag, type, or tier.">
				<div class="bento-board bento-board--cols-3 not-content">
					{related.map((r) => (
						<a
							class="bento-cell bento-linkcard bento-card bento-card--glass bento-card--interactive"
							href={r.href}>
							<span class="bento-linkcard__title">{r.label}</span>
							<span class="bento-linkcard__copy">{r.reason}</span>
							<span class="bento-linkcard__go" aria-hidden="true">
								<svg
									viewBox="0 0 24 24"
									width="16"
									height="16"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round">
									<path d="M5 12h14M13 6l6 6-6 6" />
								</svg>
							</span>
						</a>
					))}
				</div>
			</BentoShell>
		)
	}
</BentoDoc>

<style>
	.item-lore {
		padding: 0 1rem 1rem;
	}

	.item-lore__body {
		margin: 0;
		padding-inline-start: 1.25rem;
		border-inline-start: 2px solid
			color-mix(in srgb, var(--bento-accent, #94a3b8) 55%, transparent);
		font-size: 1.0625rem;
		font-style: italic;
		line-height: 1.7;
		color: var(--sl-color-gray-1);
		max-width: 52rem;
		white-space: pre-line;
	}

	.item-lore__credits {
		margin: 1.25rem 0 0;
		max-width: 52rem;
		font-size: 0.8125rem;
		line-height: 1.5;
		color: var(--sl-color-gray-3);
	}

	@media (min-width: 640px) {
		.item-lore {
			padding-inline: 1.5rem;
		}
	}
</style>
