---
import { IObjectSchema } from '@/data/schema';

const { data } = Astro.props;
const item = IObjectSchema.parse(data);

const titleCase = (v: string): string =>
	String(v ?? '')
		.replace(/[-_]/g, ' ')
		.replace(/([a-z])([A-Z])/g, '$1 $2')
		.replace(/\b\w/g, (c) => c.toUpperCase());

interface Card {
	title: string;
	rows: { label: string; value: string; href?: string }[];
	body?: string;
}

const cards: Card[] = [];

for (const recipe of item.recipes ?? []) {
	const rows = (recipe.ingredients ?? []).map((ing) => ({
		label: ing.name ?? titleCase(ing.item_ref),
		value: `×${ing.amount}`,
		href: `/itemdb/${ing.item_ref}/`,
	}));
	if (recipe.skill)
		rows.push({
			label: 'Skill',
			value: `${titleCase(recipe.skill)}${
				recipe.skill_level ? ` lv. ${recipe.skill_level}` : ''
			}`,
		});
	if (recipe.xp_reward)
		rows.push({ label: 'XP', value: String(recipe.xp_reward) });
	if (recipe.facility)
		rows.push({ label: 'Facility', value: titleCase(recipe.facility) });
	if (recipe.required_tools?.length)
		rows.push({
			label: 'Tools',
			value: recipe.required_tools.map(titleCase).join(', '),
		});
	if (recipe.output_quantity && recipe.output_quantity > 1)
		rows.push({ label: 'Yields', value: `×${recipe.output_quantity}` });
	cards.push({ title: 'Crafting', rows });
}

const equipment = item.equipment;
if (equipment) {
	const rows = [{ label: 'Slot', value: titleCase(equipment.slot) }];
	if (equipment.special)
		rows.push({
			label: titleCase(equipment.special),
			value: equipment.special_value
				? String(equipment.special_value)
				: 'Yes',
		});
	if (equipment.max_durability)
		rows.push({
			label: 'Max durability',
			value: String(equipment.max_durability),
		});
	if (equipment.enchantment_slots)
		rows.push({
			label: 'Enchant slots',
			value: String(equipment.enchantment_slots),
		});
	if (equipment.movement_penalty)
		rows.push({
			label: 'Movement penalty',
			value: `${equipment.movement_penalty}`,
		});
	if (equipment.cursed) rows.push({ label: 'Cursed', value: 'Yes' });
	cards.push({ title: 'Equipment', rows });
}

const food = item.food;
if (food) {
	const rows: Card['rows'] = [];
	if (food.heals) rows.push({ label: 'Heals', value: String(food.heals) });
	if (food.doses) rows.push({ label: 'Doses', value: String(food.doses) });
	if (food.restore_energy)
		rows.push({ label: 'Energy', value: String(food.restore_energy) });
	if (food.restore_mana)
		rows.push({ label: 'Mana', value: String(food.restore_mana) });
	if (food.duration)
		rows.push({ label: 'Duration', value: `${food.duration}s` });
	if (food.perishable)
		rows.push({
			label: 'Perishable',
			value: food.shelf_life_seconds
				? `${food.shelf_life_seconds}s shelf life`
				: 'Yes',
		});
	if (food.spoils_into_ref)
		rows.push({
			label: 'Spoils into',
			value: titleCase(food.spoils_into_ref),
			href: `/itemdb/${food.spoils_into_ref}/`,
		});
	if (rows.length) cards.push({ title: 'Consumption', rows });
}

const sources = item.sources ?? [];
if (sources.length) {
	cards.push({
		title: 'Acquisition',
		rows: sources.map((s) => {
			const qty =
				s.max_quantity && s.max_quantity !== s.min_quantity
					? `${s.min_quantity ?? 1}–${s.max_quantity}`
					: s.min_quantity
						? String(s.min_quantity)
						: null;
			const value =
				[
					s.drop_rate ? `${Math.round(s.drop_rate * 100)}%` : null,
					qty ? `×${qty}` : null,
					s.level_requirement ? `lv. ${s.level_requirement}` : null,
				]
					.filter(Boolean)
					.join(' · ') ||
				titleCase(s.source_type ?? '') ||
				'—';
			return {
				label:
					s.source_name ??
					titleCase(s.source_ref ?? s.source_type ?? 'Unknown'),
				value,
			};
		}),
	});
}

const useEffects = item.use_effects ?? [];
if (useEffects.length) {
	cards.push({
		title: 'On use',
		rows: useEffects.map((e) => ({
			label: titleCase(e.type),
			value:
				[
					e.amount !== undefined ? String(e.amount) : null,
					e.status_effect ? titleCase(e.status_effect) : null,
					e.turns ? `${e.turns} turns` : null,
					e.element ? titleCase(e.element) : null,
				]
					.filter(Boolean)
					.join(' · ') || '—',
		})),
	});
}
---

{
	cards.length > 0 && (
		<div class="bento-board bento-board--auto-wide not-content">
			{cards.map((card) => (
				<div class="bento-cell bento-featurecard bento-card bento-card--glass">
					<h3 class="bento-featurecard__title">{card.title}</h3>
					<dl class="itemdetails__rows">
						{card.rows.map((row) => (
							<div>
								<dt>
									{row.href ? (
										<a href={row.href}>{row.label}</a>
									) : (
										row.label
									)}
								</dt>
								<dd>{row.value}</dd>
							</div>
						))}
					</dl>
				</div>
			))}
		</div>
	)
}

<style>
	.itemdetails__rows {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		margin: 0;
	}

	.itemdetails__rows div {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem;
		padding-bottom: 0.35rem;
		border-bottom: 1px solid var(--bento-hairline);
	}

	.itemdetails__rows dt {
		font-size: 0.85rem;
		color: var(--sl-color-gray-2);
	}

	.itemdetails__rows dt a {
		color: inherit;
		text-decoration: none;
		border-bottom: 1px dashed var(--bento-hairline-strong);
	}

	.itemdetails__rows dt a:hover {
		color: var(--sl-color-white);
	}

	.itemdetails__rows dd {
		margin: 0;
		font-size: 0.85rem;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		color: var(--sl-color-white);
	}
</style>
