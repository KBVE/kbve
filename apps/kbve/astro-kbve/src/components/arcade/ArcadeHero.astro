---
export interface Props {
	title?: string;
	tagline?: string;
	stats?: Array<{ label: string; value: string }>;
}

const {
	title = 'KBVE Arcade',
	tagline = 'Browser games we built ourselves — plus a few classics on the way.',
	stats = [],
} = Astro.props;

const [head, ...tail] = title.split(' ');
---

<section
	class="bento-hero bento-section not-content arcade-hero"
	aria-labelledby="arcade-hero-title">
	<div class="arcade-hero__bg" aria-hidden="true"></div>
	<div class="arcade-hero__scan" aria-hidden="true"></div>
	<div class="bento-hero__frame bento-frame">
		<div class="bento-board bento-board--hero">
			<div class="bento-cell bento-hero-copy">
				<span class="bento-badge bento-chip">
					<span class="bento-live-dot"></span>
					Now playing
				</span>
				<h1 id="arcade-hero-title" class="bento-title">
					{head}{' '}
					<span class="bento-title__accent">{tail.join(' ')}</span>
				</h1>
				<p class="bento-lede">{tagline}</p>
				<div class="bento-cta">
					<a class="bento-btn bento-btn--primary" href="#available">
						Browse games
					</a>
					<a class="bento-btn bento-btn--ghost" href="#soon">
						What's coming
					</a>
				</div>
			</div>
			<div class="bento-cell bento-hero-aside arcade-hero__stats">
				{
					stats.map((s, i) => (
						<div class="arcade-hero__stat">
							<span
								class="arcade-hero__stat-value"
								data-arcade-stat
								data-arcade-stat-value={s.value}
								data-arcade-stat-delay={i * 140}>
								{s.value}
							</span>
							<span class="arcade-hero__stat-label">
								{s.label}
							</span>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>

<style>
	/* Arcade retint of the shared hero: only the backdrop and the accent
	   vars are page-specific, the layout comes from the bento primitives. */
	.arcade-hero {
		position: relative;
		isolation: isolate;
		--bento-accent: #e879f9;
		--bento-accent-2: #38bdf8;
		--bento-btn-fg: #16021c;
		--bento-live: #f0abfc;
		/* .bento-btn--primary keys off the Starlight accent, not the bento
		   one, so a retint has to set both. */
		--sl-color-accent: #c026d3;
		--sl-color-accent-high: #f0abfc;
	}

	.arcade-hero__stats {
		justify-content: center;
		gap: 1.25rem;
	}

	/* Deliberately not .bento-stat__value/__label — those are grid-placed
	   and only behave inside a .bento-stat parent. */
	.arcade-hero__stat {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding-inline-start: 0.9rem;
		border-inline-start: 2px solid
			color-mix(in srgb, var(--bento-accent) 55%, transparent);
	}

	.arcade-hero__stat-value {
		font-size: 1.4rem;
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.01em;
		color: var(--sl-color-white);
	}

	.arcade-hero__stat-label {
		font-family: var(--__sl-font-mono, ui-monospace, monospace);
		font-size: 0.6875rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--sl-color-gray-3);
	}

	.arcade-hero__bg {
		position: absolute;
		inset: 0;
		z-index: -2;
		background:
			radial-gradient(
				circle at 12% 10%,
				rgba(236, 72, 153, 0.35) 0%,
				transparent 45%
			),
			radial-gradient(
				circle at 88% 80%,
				rgba(56, 189, 248, 0.28) 0%,
				transparent 50%
			);
	}

	.arcade-hero__scan {
		position: absolute;
		inset: 0;
		z-index: -1;
		opacity: 0.45;
		background: repeating-linear-gradient(
			to bottom,
			rgba(0, 0, 0, 0.16) 0px,
			rgba(0, 0, 0, 0.16) 1px,
			transparent 1px,
			transparent 4px
		);
	}
</style>

<script is:inline data-astro-rerun>
	(() => {
		const reduceMotion =
			typeof window !== 'undefined' &&
			window.matchMedia &&
			window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const NUMERIC = /^\d+$/;

		function rollOdometer(el, target, baseDelay) {
			const digits = String(target).split('');
			el.textContent = '';
			el.style.display = 'inline-flex';
			el.style.gap = '0';
			el.style.lineHeight = '1';
			el.style.verticalAlign = 'baseline';

			digits.forEach((digit, i) => {
				const col = document.createElement('span');
				col.style.cssText =
					'display:inline-block;height:1em;overflow:hidden;line-height:1;vertical-align:baseline;';
				const reel = document.createElement('span');
				reel.style.cssText =
					'display:block;transition:transform 1400ms cubic-bezier(0.16,1,0.3,1);will-change:transform;';
				/* 30 digits stacked = 2 full spins + landing digit. */
				for (let rep = 0; rep < 3; rep++) {
					for (let n = 0; n <= 9; n++) {
						const d = document.createElement('span');
						d.textContent = String(n);
						d.style.cssText =
							'display:block;height:1em;line-height:1;';
						reel.appendChild(d);
					}
				}
				col.appendChild(reel);
				el.appendChild(col);
				const targetDigit = parseInt(digit, 10);
				const finalIdx = 20 + targetDigit;
				const colDelay = baseDelay + i * 90;
				if (reduceMotion) {
					reel.style.transition = 'none';
					reel.style.transform = `translateY(-${finalIdx}em)`;
				} else {
					requestAnimationFrame(() => {
						setTimeout(() => {
							reel.style.transform = `translateY(-${finalIdx}em)`;
						}, colDelay);
					});
				}
			});
		}

		function fadeIn(el, baseDelay) {
			if (reduceMotion) return;
			el.style.opacity = '0';
			el.style.transition = 'opacity 800ms cubic-bezier(0.16,1,0.3,1)';
			setTimeout(() => {
				el.style.opacity = '1';
			}, baseDelay);
		}

		function init() {
			const stats = document.querySelectorAll('[data-arcade-stat]');
			stats.forEach((el) => {
				const val = el.dataset.arcadeStatValue ?? '';
				const baseDelay = parseInt(
					el.dataset.arcadeStatDelay ?? '0',
					10,
				);
				if (NUMERIC.test(val)) {
					rollOdometer(el, parseInt(val, 10), baseDelay);
				} else {
					fadeIn(el, baseDelay);
				}
			});
		}

		// `data-astro-rerun` on the script tag ensures this IIFE runs on
		// every nav swap under ClientRouter, not just the initial hard
		// load. At swap time the DOM is fully present, so no readyState
		// check is needed.
		init();
	})();
</script>
