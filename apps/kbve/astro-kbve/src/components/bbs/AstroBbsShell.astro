---
import BentoShell from '@/components/hero/BentoShell.astro';
import ReactBbsClaim from './ReactBbsClaim';

const backdrop =
	'https://images.unsplash.com/photo-1515879218367-8466d910aaa4?q=80&w=2400&auto=format&fit=crop';
---

<div class="bbs-hub" style={`--bento-hero-bg: url('${backdrop}')`}>
	<section class="bento-hero bento-section not-content" aria-label="KBVE BBS">
		<div class="bento-hero__bg" aria-hidden="true"></div>
		<div class="bento-hero__frame bento-frame">
			<div class="bento-board bento-board--hero">
				<div
					class="bento-cell bento-hero-copy bento-card bento-card--glass">
					<span class="bento-badge bento-chip"><span>bbs</span></span>
					<h1 class="bento-title">
						Dial in from anything,
						<span class="bento-title__accent">
							even a Commodore 64.
						</span>
					</h1>
					<p class="bento-lede">
						The KBVE BBS is a telnet front door to the same forum,
						wallet, and accounts the website uses. It speaks PETSCII
						at 40 columns for real Commodore hardware and ANSI for
						everyone else. No password ever crosses the wire — the
						terminal shows a code and you approve it here.
					</p>
					<div class="bento-cta">
						<a class="bento-btn bento-btn--primary" href="#link">
							Link a terminal
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								aria-hidden="true">
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M5 12h14M13 6l6 6-6 6">
								</path>
							</svg>
						</a>
						<a class="bento-btn bento-btn--ghost" href="/forum/">
							Forum
						</a>
					</div>
				</div>
				{
					[
						{
							v: 'PETSCII :6400',
							l: 'CCGMS, 40 columns, C64 Wi-Fi modems',
						},
						{ v: 'ANSI :6401', l: 'SyncTERM, PuTTY, plain telnet' },
						{
							v: 'One account',
							l: 'Same Supabase identity as the site',
						},
					].map((s) => (
						<div class="bento-cell bento-stat bento-card bento-card--glass">
							<span class="bento-stat__value">{s.v}</span>
							<span class="bento-stat__label">{s.l}</span>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<BentoShell id="link" eyebrow="Terminal login" heading="Link a terminal">
		<div class="bbs-island">
			<ReactBbsClaim client:only="react" />
		</div>
	</BentoShell>

	<BentoShell id="how" eyebrow="Connect" heading="How to call in">
		<div class="bbs-steps">
			<article class="bento-card bento-card--glass bbs-step">
				<h3>Commodore 64</h3>
				<p>
					Load CCGMS with a Wi-Fi modem on the user port, then dial:
				</p>
				<pre class="bbs-pre"><code>ATDTbbs.kbve.com:6400</code></pre>
				<p>You get PETSCII colours and a 40-column board.</p>
			</article>
			<article class="bento-card bento-card--glass bbs-step">
				<h3>Modern terminal</h3>
				<p>
					Any telnet client works; the ANSI port adapts to your window
					size:
				</p>
				<pre class="bbs-pre"><code>telnet bbs.kbve.com 6401</code></pre>
				<p>SyncTERM and friends are auto-detected by terminal type.</p>
			</article>
			<article class="bento-card bento-card--glass bbs-step">
				<h3>Logging in</h3>
				<p>
					Pick <strong>[L]</strong> on the main menu. The board prints a
					short code; type it above while signed in here and the terminal
					flips to your account. Codes are single-use and expire in five
					minutes.
				</p>
				<p class="bbs-step__warn">
					Only enter a code you are reading off your own screen. A
					code someone else sends you would hand their terminal your
					account.
				</p>
			</article>
		</div>
	</BentoShell>
</div>

<style>
	.bbs-island {
		min-height: 30vh;
	}
	.bbs-steps {
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
	}
	.bbs-step {
		padding: 1.25rem;
	}
	.bbs-step h3 {
		margin: 0 0 0.5rem;
		font-size: 1.05rem;
	}
	.bbs-step__warn {
		color: #fbbf24;
		font-size: 0.9rem;
	}
	.bbs-pre {
		margin: 0.75rem 0;
		padding: 0.6rem 0.75rem;
		border-radius: 0.5rem;
		overflow-x: auto;
		background: color-mix(in oklab, var(--bento-accent) 12%, transparent);
	}
</style>

<style is:global>
	.bbs-hub {
		--bento-accent: #4ade80;
		--bento-accent-2: #22d3ee;
		--bento-btn-fg: #05210f;
	}
	.bbs-claim {
		display: grid;
		gap: 1rem;
		max-width: 34rem;
	}
	.bbs-claim__dial {
		display: grid;
		gap: 0.35rem;
	}
	.bbs-claim__dial-label {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		opacity: 0.7;
	}
	.bbs-claim__dial-value {
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.95rem;
	}
	.bbs-claim__form,
	.bbs-claim__gate {
		display: grid;
		gap: 0.6rem;
		justify-items: start;
	}
	.bbs-claim__label {
		font-size: 0.85rem;
		opacity: 0.8;
	}
	.bbs-claim__input {
		width: 100%;
		max-width: 14rem;
		padding: 0.6rem 0.75rem;
		border-radius: 0.5rem;
		border: 1px solid color-mix(in oklab, currentColor 25%, transparent);
		background: transparent;
		color: inherit;
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 1.35rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}
	.bbs-claim__msg {
		margin: 0;
		font-size: 0.9rem;
	}
	.bbs-claim__msg--ok {
		color: #4ade80;
	}
	.bbs-claim__msg--err {
		color: #f87171;
	}
	.bbs-claim__who {
		margin: 0;
		font-size: 0.8rem;
		opacity: 0.6;
	}
</style>
