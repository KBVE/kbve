TC9_IMAGE_TAG=master
AC_DB_IMPORT_IMAGE=acore/ac-wotlk-db-import:16.0.0-dev

DATABASE_SCHEMA_TYPE=ac

DB_HOST=mysql
DB_PORT=3306
DB_USER=acore
DB_PASS=acore

AUTH_DB_HOST=mysql
AUTH_DB_PORT=3306
AUTH_DB_USER=acore
AUTH_DB_PASS=acore
AUTH_DB_NAME=acore_auth

WORLD_DB_HOST=mysql
WORLD_DB_PORT=3306
WORLD_DB_USER=acore
WORLD_DB_PASS=acore
WORLD_DB_NAME=acore_world

CHAR_DB_HOST=mysql
CHAR_DB_PORT=3306
CHAR_DB_USER=acore
CHAR_DB_PASS=acore
CHAR_DB_NAME=acore_characters

EXTERNAL_ADDRESS=127.0.0.1
LAYER_MAPS=

# AzerothCore client data. The mmaps generator version is a property of the CORE
# binary, not of the data: the pinned gameserver-ac image expects generator v19,
# and v20 tiles are rejected per-tile with
#   MMAP:loadMap: <tile>.mmtile was built with generator v19, expected v20
# leaving creatures without a navmesh (they stop moving). Keep this on v19 for as
# long as the base stack runs the pinned image -- the playerbots overlay carries
# a different core and overrides this to v20 on its own.
CLIENT_DATA_URL=https://github.com/wowgaming/client-data/releases/download/v19/Data.zip
WORLDSERVER_CONF_URL=https://raw.githubusercontent.com/walkline/azerothcore-wotlk/cluster-mode/src/server/apps/worldserver/worldserver.conf.dist

# --- mod-playerbots overlay (docker-compose.playerbots.yml) ---
# mod-playerbots requires its own database in addition to auth/world/characters.
PLAYERBOTS_DB_HOST=mysql
PLAYERBOTS_DB_PORT=3306
PLAYERBOTS_DB_USER=acore
PLAYERBOTS_DB_PASS=acore
PLAYERBOTS_DB_NAME=acore_playerbots

PLAYERBOTS_TAG=dev
# Native build. Set to linux/amd64 in CI / for the cluster.
PLAYERBOTS_PLATFORM=linux/arm64

AI_PLAYERBOT_ENABLED=1
# Upstream default is 500; start small so bot bugs stay distinguishable from CPU starvation.
AI_PLAYERBOT_MAX_RANDOM_BOTS=20
AI_PLAYERBOT_RANDOM_BOT_AUTOLOGIN=1
