{
	"name": "agones-tocloud9",
	"$schema": "../../../node_modules/nx/schemas/project-schema.json",
	"projectType": "application",
	"sourceRoot": "apps/agones/tocloud9",
	"tags": ["scope:agones", "tocloud9", "game"],
	"targets": {
		"env": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "apps/agones/tocloud9",
				"command": "[ -f .env ] || cp .env.example .env; echo 'apps/agones/tocloud9/.env ready'"
			}
		},
		"setup": {
			"executor": "nx:run-commands",
			"dependsOn": ["env"],
			"options": {
				"cwd": "apps/agones/tocloud9",
				"parallel": false,
				"commands": [
					"echo 'Downloading ~3.5GB of WoW 3.3.5a client data and importing the AzerothCore schema. First run takes a long while.'",
					"docker compose --profile setup up --abort-on-container-failure --exit-code-from tc9-sql download-miscs tc9-sql",
					"docker compose --profile setup down"
				]
			}
		},
		"up": {
			"executor": "nx:run-commands",
			"dependsOn": ["env"],
			"options": {
				"cwd": "apps/agones/tocloud9",
				"command": "docker compose --profile ac up -d"
			}
		},
		"dev": {
			"executor": "nx:run-commands",
			"dependsOn": ["env"],
			"options": {
				"cwd": "apps/agones/tocloud9",
				"command": "trap 'docker compose --profile ac down' EXIT INT TERM; docker compose --profile ac up"
			}
		},
		"scale": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "apps/agones/tocloud9",
				"command": "docker compose --profile ac up -d --scale gameserver-ac=${TC9_WORLDSERVERS:-2} --no-recreate"
			}
		},
		"logs": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "apps/agones/tocloud9",
				"command": "docker compose --profile ac logs -f --tail=200"
			}
		},
		"ps": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "apps/agones/tocloud9",
				"command": "docker compose --profile ac ps"
			}
		},
		"down": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "apps/agones/tocloud9",
				"command": "docker compose --profile ac --profile setup down"
			}
		},
		"nuke": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "apps/agones/tocloud9",
				"command": "docker compose --profile ac --profile setup down -v"
			}
		},
		"playerbots:build": {
			"executor": "nx:run-commands",
			"cache": false,
			"dependsOn": ["env"],
			"options": {
				"cwd": "apps/agones/tocloud9",
				"parallel": false,
				"commands": [
					"echo 'Building the full KBVE ToCloud9 stack: 12 Go services (fast) plus AzerothCore + mod-playerbots + libsidecar (slow). Expect tens of minutes and every core pegged.'",
					"docker compose -f docker-compose.yml -f docker-compose.playerbots.yml --profile ac --profile setup build"
				]
			}
		},
		"playerbots:setup": {
			"executor": "nx:run-commands",
			"dependsOn": ["playerbots:build"],
			"options": {
				"cwd": "apps/agones/tocloud9",
				"parallel": false,
				"commands": [
					"docker compose -f docker-compose.yml -f docker-compose.playerbots.yml --profile setup up --abort-on-container-failure --exit-code-from tc9-sql download-miscs tc9-sql",
					"docker compose -f docker-compose.yml -f docker-compose.playerbots.yml --profile setup down"
				]
			}
		},
		"playerbots:up": {
			"executor": "nx:run-commands",
			"dependsOn": ["env"],
			"options": {
				"cwd": "apps/agones/tocloud9",
				"command": "docker compose -f docker-compose.yml -f docker-compose.playerbots.yml --profile ac up -d"
			}
		},
		"playerbots:logs": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "apps/agones/tocloud9",
				"command": "docker compose -f docker-compose.yml -f docker-compose.playerbots.yml --profile ac logs -f --tail=200 gameserver-ac"
			}
		},
		"playerbots:down": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "apps/agones/tocloud9",
				"command": "docker compose -f docker-compose.yml -f docker-compose.playerbots.yml --profile ac --profile setup down"
			}
		},
		"e2e": {
			"executor": "nx:run-commands",
			"cache": false,
			"options": {
				"cwd": "apps/agones/tocloud9",
				"parallel": false,
				"commands": [
					"echo 'Waiting for a worldserver to register with servers-registry (<=600s; AzerothCore map loading is slow)...' && for i in $(seq 1 600); do if [ -n \"$(docker compose --profile ac exec -T redis redis-cli --raw KEYS 'ws:*' 2>/dev/null | tr -d '[:space:]')\" ]; then echo \"worldserver registered after ${i}s\"; break; fi; if [ $(( i % 30 )) -eq 0 ]; then echo \"--- [${i}s] still waiting ---\"; docker compose --profile ac logs --tail=5 gameserver-ac 2>&1 | sed 's/^/  | /'; fi; if [ $i -eq 600 ]; then echo 'FAIL: no worldserver registered in 600s'; docker compose --profile ac logs --tail=80 gameserver-ac servers-registry 2>&1 | sed 's/^/  | /'; exit 1; fi; sleep 1; done",
					"npx vitest run --config vitest.e2e.config.ts"
				]
			}
		},
		"container-gameserver": {
			"executor": "@nx-tools/nx-container:build",
			"defaultConfiguration": "local",
			"options": {
				"engine": "docker",
				"context": ".",
				"file": "apps/agones/tocloud9/gameserver/Dockerfile",
				"load": true,
				"target": "gameserver",
				"build-contexts": ["modules=apps/agones/tocloud9/modules"]
			},
			"configurations": {
				"local": {
					"load": true,
					"push": false,
					"tags": ["kbve/tocloud9-gameserver-playerbots:latest"]
				},
				"production": {
					"push": true,
					"tags": [
						"ghcr.io/kbve/tocloud9-gameserver-playerbots:latest"
					],
					"cache-from": [
						"type=registry,ref=ghcr.io/kbve/tocloud9-gameserver-playerbots:buildcache"
					],
					"cache-to": [
						"type=registry,ref=ghcr.io/kbve/tocloud9-gameserver-playerbots:buildcache,mode=max"
					]
				}
			}
		},
		"container-db-import": {
			"executor": "@nx-tools/nx-container:build",
			"defaultConfiguration": "local",
			"options": {
				"engine": "docker",
				"context": ".",
				"file": "apps/agones/tocloud9/gameserver/Dockerfile",
				"load": true,
				"target": "db-import",
				"build-contexts": ["modules=apps/agones/tocloud9/modules"]
			},
			"configurations": {
				"local": {
					"load": true,
					"push": false,
					"tags": ["kbve/tocloud9-db-import-playerbots:latest"]
				},
				"production": {
					"push": true,
					"tags": [
						"ghcr.io/kbve/tocloud9-db-import-playerbots:latest"
					],
					"cache-from": [
						"type=registry,ref=ghcr.io/kbve/tocloud9-db-import-playerbots:buildcache"
					],
					"cache-to": [
						"type=registry,ref=ghcr.io/kbve/tocloud9-db-import-playerbots:buildcache,mode=max"
					]
				}
			}
		},
		"container-services": {
			"executor": "@nx-tools/nx-container:build",
			"defaultConfiguration": "local",
			"options": {
				"engine": "docker",
				"context": ".",
				"file": "apps/agones/tocloud9/services/Dockerfile",
				"load": true
			},
			"configurations": {
				"local": {
					"load": true,
					"push": false,
					"tags": ["kbve/tocloud9-services-playerbots:latest"]
				},
				"production": {
					"push": true,
					"tags": [
						"ghcr.io/kbve/tocloud9-services-playerbots:latest"
					],
					"cache-from": [
						"type=registry,ref=ghcr.io/kbve/tocloud9-services-playerbots:buildcache"
					],
					"cache-to": [
						"type=registry,ref=ghcr.io/kbve/tocloud9-services-playerbots:buildcache,mode=max"
					]
				}
			}
		}
	}
}
