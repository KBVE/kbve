#!/usr/bin/env sh
# Conventional commit check — the same tools/commit/validate.mjs the CI job runs
# against pull request titles, so a scope that would fail there fails here first.
#
# Scopes are moon project ids and are case sensitive: KBVEWorld, not kbveworld.
# That is what keeps a commit tied to the project it changed, because
# tools/release/notes.mjs groups by scope when it writes a release note.
#
# Reads the committed scopes.lock.json, so it needs node and nothing else --
# no moon, no toolchain, no install step.
command -v node >/dev/null 2>&1 || exit 0

exec node tools/commit/validate.mjs "$1"
