# Git LFS — Unity native plugins
#
# Stored on forgejo.kbve.com/KBVE/rareicon.git via the .lfsconfig
# endpoint. Pointer files (text, ~150 bytes) live in this GitHub repo;
# real binaries live on the self-hosted Forgejo LFS.
#
# Pattern coverage:
#   - libuniti.dylib  (Rust FFI shared library, macOS)
#   - uniti.dll       (Rust FFI shared library, Windows)
#   - libuniti.so     (Rust FFI shared library, Linux + Android per-ABI)
#   - libuniti.a      (Rust FFI static library, iOS — inside uniti.xcframework/)
#   - any future native plugin under apps/rareicon/**/Plugins/**
apps/rareicon/**/Plugins/**/*.dylib filter=lfs diff=lfs merge=lfs -text
apps/rareicon/**/Plugins/**/*.dll   filter=lfs diff=lfs merge=lfs -text
apps/rareicon/**/Plugins/**/*.so    filter=lfs diff=lfs merge=lfs -text
apps/rareicon/**/Plugins/**/*.a     filter=lfs diff=lfs merge=lfs -text
apps/rareicon/**/Plugins/**/*.bundle filter=lfs diff=lfs merge=lfs -text
apps/rareicon/**/Plugins/**/*.framework/** filter=lfs diff=lfs merge=lfs -text
apps/rareicon/**/Assets/_RareIcon/Textures/Environment/**/*.png filter=lfs diff=lfs merge=lfs -text
# XCFramework binary slices — Info.plist + headers stay text, the
# library payload (.a per arch slice) is matched by the *.a rule above.
# Explicit rule for any future *.framework wrapped libraries too.

# Godot GDExtension prebuilt binaries (gdext rust crates under apps/godot/<game>/addons/<name>/bin/)
# Same storage strategy: pointer files here, blobs on Forgejo.
apps/godot/**/addons/**/bin/**/*.dylib filter=lfs diff=lfs merge=lfs -text
apps/godot/**/addons/**/bin/**/*.dll   filter=lfs diff=lfs merge=lfs -text
apps/godot/**/addons/**/bin/**/*.so    filter=lfs diff=lfs merge=lfs -text
apps/godot/**/addons/**/bin/**/*.wasm  filter=lfs diff=lfs merge=lfs -text

# KBVE UE plugin native libs (packages/unreal/**) are intentionally NORMAL git
# blobs, NOT LFS — static (.a/.lib) and shared (.dylib/.dll/.so/.bundle) alike.
# A plain clone (and the CI plugin build) gets every prebuilt lib at link/load
# time with no LFS pull. Plugin libs are pinned third-party versions that change
# rarely, so the history cost is acceptable for the zero-friction download.

# Unreal Engine — apps/rareicon/unreal binary assets
# Pointer files live in this repo; blobs live on git.kbve.com/KBVE/rareicon.git
# (see apps/rareicon/unreal/.lfsconfig, and the repo-root .lfsconfig
# which already defaults to that endpoint). Added before the first level was
# saved: without it a .umap lands in plain git on GitHub, and rewriting that
# out of history later is far more work than one rule now.
# UE cooked / serialized assets
apps/rareicon/unreal*/**/*.uasset filter=lfs diff=lfs merge=lfs -text
apps/rareicon/unreal*/**/*.umap   filter=lfs diff=lfs merge=lfs -text
# Raw 3D / DCC source art
apps/rareicon/unreal*/**/*.fbx    filter=lfs diff=lfs merge=lfs -text
apps/rareicon/unreal*/**/*.obj    filter=lfs diff=lfs merge=lfs -text
apps/rareicon/unreal*/**/*.blend  filter=lfs diff=lfs merge=lfs -text
apps/rareicon/unreal*/**/*.psd    filter=lfs diff=lfs merge=lfs -text
# Textures
apps/rareicon/unreal*/**/*.png    filter=lfs diff=lfs merge=lfs -text
apps/rareicon/unreal*/**/*.jpg    filter=lfs diff=lfs merge=lfs -text
apps/rareicon/unreal*/**/*.jpeg   filter=lfs diff=lfs merge=lfs -text
apps/rareicon/unreal*/**/*.tga    filter=lfs diff=lfs merge=lfs -text
apps/rareicon/unreal*/**/*.exr    filter=lfs diff=lfs merge=lfs -text
apps/rareicon/unreal*/**/*.hdr    filter=lfs diff=lfs merge=lfs -text
apps/rareicon/unreal*/**/*.r16    filter=lfs diff=lfs merge=lfs -text
# Audio
apps/rareicon/unreal*/**/*.wav    filter=lfs diff=lfs merge=lfs -text
apps/rareicon/unreal*/**/*.mp3    filter=lfs diff=lfs merge=lfs -text
apps/rareicon/unreal*/**/*.ogg    filter=lfs diff=lfs merge=lfs -text
apps/rareicon/unreal*/**/*.flac   filter=lfs diff=lfs merge=lfs -text

