# Monorepo build context exclusions
# Only include what the Dockerfile COPY commands actually need

# Version control
.git

# Node
node_modules

# Rust build artifacts
target

# Environment / Secrets
**/.env*
*.local

# Astro content-layer cache (rebuilt from buildkit cache mount, never the context)
.astro

# IDE / Editor
.vscode
.idea
*.swp
*.swo

# CI / Config
.github
.claude
.moon/cache

# Large / irrelevant app directories not needed by any Dockerfile
apps/godot
!apps/godot/nexus-defense/server
apps/unity

# Playwright output. e2e suites now live inside the api project directory a
# Dockerfile COPYs wholesale, so these would otherwise enter the build context.
**/playwright-report
**/test-results
